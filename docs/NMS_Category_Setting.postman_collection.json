{
  "info": {
    "name": "NMS - Category & Setting",
    "description": "Demo CRUD Category và SystemSetting. Chạy backend trước (http://localhost:8080). Request tạo mới tự lưu ID vào biến collection để các request sau dùng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "categoryId", "value": "" },
    { "key": "childCategoryId", "value": "" },
    { "key": "settingId", "value": "" }
  ],
  "item": [
    {
      "name": "Category",
      "item": [
        {
          "name": "1. Tạo danh mục gốc",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('categoryId', pm.response.json().categoryId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"categoryName\": \"Thể thao\",\n  \"categoryDescription\": \"Tin tức thể thao\",\n  \"parentCategoryId\": null,\n  \"isActive\": 1\n}" }
          }
        },
        {
          "name": "2. Tạo danh mục con",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('childCategoryId', pm.response.json().categoryId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"categoryName\": \"Bóng đá\",\n  \"categoryDescription\": \"Tin bóng đá\",\n  \"parentCategoryId\": {{categoryId}},\n  \"isActive\": 1\n}" }
          }
        },
        {
          "name": "3. Lấy tất cả danh mục",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" }
        },
        {
          "name": "4. Lấy danh mục theo ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/{{categoryId}}" }
        },
        {
          "name": "5. Cập nhật danh mục",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}",
            "body": { "mode": "raw", "raw": "{\n  \"categoryName\": \"Thể thao 24h\",\n  \"categoryDescription\": \"Đã cập nhật\",\n  \"parentCategoryId\": null,\n  \"isActive\": 1\n}" }
          }
        },
        {
          "name": "6. Lỗi 400 - tên rỗng",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"categoryName\": \"\",\n  \"isActive\": 1\n}" }
          }
        },
        {
          "name": "7. Lỗi 409 - xóa danh mục còn con",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{categoryId}}" }
        },
        {
          "name": "8. Xóa danh mục con",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{childCategoryId}}" }
        },
        {
          "name": "9. Xóa danh mục gốc",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{categoryId}}" }
        },
        {
          "name": "10. Lỗi 404 - ID không tồn tại",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/99999" }
        }
      ]
    },
    {
      "name": "Setting",
      "item": [
        {
          "name": "1. Tạo cấu hình",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('settingId', pm.response.json().settingId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/settings",
            "body": { "mode": "raw", "raw": "{\n  \"settingKey\": \"SiteName\",\n  \"settingValue\": \"FU News Management\",\n  \"description\": \"Tên hiển thị của website\"\n}" }
          }
        },
        {
          "name": "2. Lấy tất cả cấu hình",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/settings" }
        },
        {
          "name": "3. Lấy cấu hình theo ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/settings/{{settingId}}" }
        },
        {
          "name": "4. Lấy cấu hình theo key",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/settings/key/SiteName" }
        },
        {
          "name": "5. Cập nhật cấu hình",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/settings/{{settingId}}",
            "body": { "mode": "raw", "raw": "{\n  \"settingKey\": \"SiteName\",\n  \"settingValue\": \"Tin tức FPT\",\n  \"description\": \"Đã đổi tên\"\n}" }
          }
        },
        {
          "name": "6. Lỗi 409 - key trùng",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/settings",
            "body": { "mode": "raw", "raw": "{\n  \"settingKey\": \"SiteName\",\n  \"settingValue\": \"abc\"\n}" }
          }
        },
        {
          "name": "7. Xóa cấu hình",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/settings/{{settingId}}" }
        }
      ]
    }
  ]
}
